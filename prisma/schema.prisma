datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth Account
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// User Model
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  password      String?   // For development/mock credentials provider
  eloRating     Int       @default(1000)
  streak        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  preferences   UserPreference?
  
  // Collaborative sessions where this user is user1 or user2
  sessionsAsUser1 CodingSession[] @relation("User1Sessions")
  sessionsAsUser2 CodingSession[] @relation("User2Sessions")

  // Messages sent by user
  messages      Message[]

  // Ratings given/received
  ratingsGiven    Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")

  // Badges
  badges        UserBadge[]
}

// User Preferences
model UserPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  languages      String[] // e.g., ["C++", "Python"]
  topics         String[] // e.g., ["Arrays", "Trees", "DP"]
  skillLevel     String   // e.g., "Beginner", "Intermediate", "Advanced"
  rolePreference String   // e.g., "helper", "helpee", "both"
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Collaborative Debug Rooms / Coding Sessions
model CodingSession {
  id           String    @id @default(cuid())
  user1Id      String
  user2Id      String
  problemUrl   String?
  problemTitle String?
  problemText  String?   @db.Text
  difficulty   String?   // e.g., "Easy", "Medium", "Hard"
  language     String?
  topic        String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  skipReason   String?   // if skipped, reason details
  isCompleted  Boolean   @default(false)

  user1        User      @relation("User1Sessions", fields: [user1Id], references: [id], onDelete: Cascade)
  user2        User      @relation("User2Sessions", fields: [user2Id], references: [id], onDelete: Cascade)

  snapshots    SessionSnapshot[]
  messages     Message[]
  ratings      Rating[]
}

// Session Snapshots for History / Replay
model SessionSnapshot {
  id          String        @id @default(cuid())
  sessionId   String
  timestamp   DateTime      @default(now())
  codeState   String        @db.Text
  runOutputs  Json?         // Stores compilation execution results
  session     CodingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Messaging / Chat
model Message {
  id          String        @id @default(cuid())
  sessionId   String
  senderId    String
  content     String        @db.Text
  type        String        @default("text") // "text", "code", "voice"
  createdAt   DateTime      @default(now())

  session     CodingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// Peer Ratings post-session
model Rating {
  id          String        @id @default(cuid())
  sessionId   String
  raterId     String
  rateeId     String
  score       Int           // e.g. 1 to 5
  feedback    String?       @db.Text
  createdAt   DateTime      @default(now())

  session     CodingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rater       User          @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  ratee       User          @relation("RatingsReceived", fields: [rateeId], references: [id], onDelete: Cascade)
}

// Gamification: Badges
model Badge {
  id           String      @id @default(cuid())
  name         String      @unique
  description  String
  criteriaJson Json        // Definition details for triggering the badge
  users        UserBadge[]
}

// User earned badges
model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
